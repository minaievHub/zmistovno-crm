NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Admin creation and server-only Telegram storage/queue. Never use NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Адміністратор

# Telegram: server-only secrets, required only for real Telegram integration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TELEGRAM_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
APP_URL=http://127.0.0.1:3000
